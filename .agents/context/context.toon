project:
  name: fikr-studio
  status: in-development
  created: "2026-01-01"
  last_updated: "2026-08-06"
  last_commit: "see git log"

stack:
  desktop: Electron
  frontend: React + TypeScript
  bundler: "Next.js static export"
  styling: "Tailwind CSS v4 + Shadcn/UI (Radix)"
  state: "React state in the renderer"
  database: "Versioned JSON workspace with optional Plus/Pro cloud mirror"
  vector_store: "Deterministic local lexical relevance vectors"
  local_llm: "None; BYOK or managed AI is required for generation"
  markdown_editor: "Tiptap 3 Markdown-native Write mode with CodeMirror 6 Source and icon-only no-rewrite AI Format and Clean up toolbar actions"
  language: TypeScript

agentic:
  context_format: TOON
  skills_dir: .agents/skills/
  workflows_dir: .agents/workflows/
  context_dir: .agents/context/
  task_manager: .agents/skills/task-manager/manage.sh
  validate: .agents/skills/validate-code/validate.sh
  heartbeat: .agents/skills/heartbeat/pulse.sh

architecture:
  philosophy: "The LLM is the runtime. Code is just the execution boundary."
  renderer: "Next.js static export loaded by Electron (next build && next export → out/)"
  ipc: "All OS access via preload.js context bridge + main.js handlers"
  state: "React state in renderer; workspace persistence in Electron main process"
  mcp_local: "localhost:3025/sse — free tier, requires Studio open"
  mcp_cloud: "fikr.one/api/mcp/relay — Plus/Pro authenticated tunnel, requires Studio open"

key_decisions[10]{id,decision,adr}:
  001,Next.js static export loaded inside Electron — two layers with strict IPC boundary,.agents/context/adrs/001-nextjs-electron-hybrid-architecture.md
  003,Two-tier MCP (local SSE + cloud Firestore relay) with fikr-studio-mcp NPM proxy,.agents/context/adrs/003-mcp-two-tier-architecture.md
  004,Auth via fikr.one deep link (fikr-studio://auth) + signInWithCustomToken — no standalone auth,.agents/context/adrs/004-sso-deeplink-auth.md
  007,Desktop keeps local JSON state and uses token-verified fikr.one APIs for managed sync; local search uses dependency-free relevance vectors,.agents/context/adrs/007-production-data-and-search-boundary.md
  008,Renderer uses React state and no direct Firestore access; cloud account workspace and relay operations are server-authorized,.agents/context/adrs/008-production-renderer-and-relay-boundary.md
  010,Development SSO returns through a one-shot loopback callback while packaged builds retain the registered fikr-studio protocol,.agents/context/adrs/010-development-sso-loopback-callback.md
  011,Knowledge entries keep raw Markdown authoritative and use CodeMirror for source editing with the existing GFM renderer for preview,.agents/context/adrs/011-source-first-markdown-entry-editor.md
  012,Knowledge entries default to a Tiptap formatted writing projection while raw Markdown remains authoritative through explicit Source and Preview modes,.agents/context/adrs/012-markdown-native-rich-writing-surface.md
  013,The Markdown editor exposes only Write and Source; AI Format and Clean up are icon-only in-place toolbar actions with no theme-token changes,.agents/context/adrs/013-two-mode-markdown-editor-controls.md
  014,macOS releases use one fail-closed local and CI pipeline that verifies redownloaded draft assets before publication,.agents/context/adrs/014-fail-closed-macos-release-delivery.md

key_rules:
  - "Firebase Admin credentials never ship in the desktop app"
  - "BYOK credentials stay in Electron main; renderer AI calls use the fixed-provider IPC proxy"
  - "Cloud identity and plan are derived from a verified ID token on fikr.one"
  - "Auth always via fikr.one SSO deep link — no standalone Firebase auth"
  - "npm run lint && npx tsc --noEmit must pass before every commit"
  - "create_note_synthesized preferred over create_note for agent writes"
  - "NPM tokens for fikr-studio-mcp never committed to git"

# Active tasks tracked in .agents/skills/task-manager/todo.toon
