{
  "appId": "com.fikr.studio",
  "productName": "Fikr Studio",
  "directories": {
    "output": "dist"
  },
  "afterPack": "scripts/after-pack.js",
  "protocols": [
    {
      "name": "Fikr Studio Authentication",
      "schemes": ["fikr-studio"]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "bigmints",
      "repo": "fikr-studio",
      "releaseType": "draft"
    }
  ],
  "files": [
    "out/**/*",
    "main.js",
    "preload.js",
    "package.json",
    "lib/*.js",
    "scripts/mcp-bridge.mjs",
    "!node_modules/**/*.map",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.d.mts",
    "!node_modules/**/*.d.cts",
    "!node_modules/**/*.ts",
    "!node_modules/**/*.mts",
    "!node_modules/**/*.cts",
    "!node_modules/**/*.mjs",
    "!node_modules/**/src/**",
    "node_modules/debug/src/**/*.js",
    "!node_modules/**/test/**",
    "!node_modules/**/tests/**",
    "!node_modules/**/README*",
    "!node_modules/**/CHANGELOG*",
    "!node_modules/zod/**/*.js",
    "!node_modules/@openai/agents-core/dist/testing/**",
    "!node_modules/@openai/agents-openai/dist/experimental/**",
    "!node_modules/@openai/agents-openai/dist/memory/**",
    "!node_modules/@openai/agents-openai/dist/openaiProvider.js",
    "!node_modules/@openai/agents-openai/dist/openaiResponses*.js",
    "!node_modules/@openai/agents-openai/dist/responsesWebSocket*.js",
    "!node_modules/@openai/agents-openai/dist/openaiTracingExporter.js",
    "!node_modules/@openai/agents-openai/dist/tools.js",
    "!node_modules/openai/resources/**",
    "!node_modules/openai/auth/**",
    "!node_modules/openai/realtime/**",
    "!node_modules/openai/beta/**",
    "!node_modules/openai/providers/**",
    "!node_modules/openai/client.js",
    "!node_modules/openai/index.js",
    "!node_modules/openai/azure.js",
    "!node_modules/openai/bedrock.js",
    "!node_modules/openai/api-promise.js",
    "!node_modules/openai/pagination.js",
    "!node_modules/openai/resource.js",
    "!node_modules/openai/streaming.js",
    "!node_modules/openai/uploads.js",
    "!node_modules/openai/version.js"
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"],
    "hardenedRuntime": true,
    "identity": "Pretheesh Thomas (FBG8NKYPUJ)",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist"
  },
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  }
}
